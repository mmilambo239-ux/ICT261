<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.customermanager.controller.CustomerController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <top>
        <VBox spacing="10">
            <padding>
                <Insets bottom="10"/>
            </padding>

            <Label text="Customer name"/>
            <TextField fx:id="nameField" promptText="e.g., Mary Banda"/>

            <Label text="Province"/>
            <ComboBox fx:id="provinceBox" promptText="Choose a province" maxWidth="Infinity"/>

            <HBox spacing="10">
                <Button fx:id="saveButton" text="Save Customer" onAction="#handleSave"/>
                <Button text="Delete Selected" onAction="#handleDelete"/>
            </HBox>

            <Label fx:id="statusLabel" style="-fx-text-fill: red;"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="customerTable">
            <columns>
                <TableColumn fx:id="nameColumn" text="Customer name"/>
                <TableColumn fx:id="provinceColumn" text="Province"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>