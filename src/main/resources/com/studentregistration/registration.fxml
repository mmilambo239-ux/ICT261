<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studentregistration.controller.RegistrationController"
            prefWidth="900"
            prefHeight="600">

    <top>
        <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #1f4e79;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="STUDENT REGISTRATION SYSTEM" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="ICT161" style="-fx-text-fill: #d0e0e3; -fx-font-size: 14px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Register Student" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="10">
                <Label text="Student ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="idField" promptText="Enter student ID" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="nameField" promptText="Enter full name" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Program:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="programField" promptText="Enter program" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="emailField" promptText="Enter email address" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </GridPane>

            <HBox spacing="10">
                <Button fx:id="registerButton" text="Register Student" onAction="#handleRegister" style="-fx-font-weight: bold;"/>
                <Button fx:id="clearButton" text="Clear" onAction="#handleClear"/>
                <Button fx:id="deleteButton" text="Delete Selected" onAction="#handleDelete"/>
            </HBox>

            <Label text="Registered Students" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="Student ID" prefWidth="150"/>
                    <TableColumn fx:id="nameColumn" text="Full Name" prefWidth="200"/>
                    <TableColumn fx:id="programColumn" text="Program" prefWidth="200"/>
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="220"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>